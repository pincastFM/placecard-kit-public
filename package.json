{
  "name": "@pincast/placecard-kit",
  "version": "1.8.0",
  "description": "Vue components and logic for a table of collectible cards: sort, filter, flip, plan a walk. Any app can draw its own cards with it.",
  "keywords": [
    "vue",
    "cards",
    "collection",
    "card-table",
    "maps",
    "walking-tour",
    "itinerary",
    "placecard",
    "pincast"
  ],
  "homepage": "https://github.com/pincastFM/placecard-kit-public#readme",
  "bugs": {
    "url": "https://github.com/pincastFM/placecard-kit-public/issues"
  },
  "license": "MIT",
  "author": "Pincast, Inc.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pincastFM/placecard-kit-public.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "core",
    "nav",
    "vue",
    "css",
    "conformance",
    "moderation",
    "registry",
    "sql",
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./core/index.d.ts",
      "default": "./core/index.js"
    },
    "./nav": {
      "types": "./nav/index.d.ts",
      "import": "./nav/index.js"
    },
    "./planner": {
      "types": "./dist/planner/index.d.ts",
      "import": "./dist/planner/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./arrival": {
      "types": "./dist/arrival/index.d.ts",
      "import": "./dist/arrival/index.js"
    },
    "./vue": "./vue/index.js",
    "./vue/*.vue": "./vue/*.vue",
    "./vue/*.js": "./vue/*.js",
    "./css/*": "./css/*",
    "./conformance": {
      "types": "./conformance/index.d.ts",
      "import": "./conformance/index.js"
    },
    "./conformance/*.js": "./conformance/*.js",
    "./moderation": {
      "types": "./moderation/index.d.ts",
      "import": "./moderation/index.js"
    },
    "./registry": {
      "types": "./registry/index.d.ts",
      "import": "./registry/index.js"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vue": ">=3.3.4 <4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "css": "node scripts/css.mjs",
    "classes": "node scripts/classes.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "esbuild": "0.21.5",
    "jsdom": "24.1.3",
    "postcss": "8.5.32",
    "typescript": "5.9.2",
    "vitest": "1.6.1",
    "vue": "3.3.4"
  },
  "dependencies": {
    "@turf/along": "~7.2.0",
    "@turf/bearing": "~7.2.0",
    "@turf/destination": "~7.2.0",
    "@turf/distance": "~7.2.0",
    "@turf/helpers": "~7.2.0",
    "@turf/length": "~7.2.0",
    "@turf/nearest-point-on-line": "~7.2.0"
  }
}
